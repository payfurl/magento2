{
  "name": "payfurl/module-payment",
  "description": "payFURL payments for Magento 2 / Adobe Commerce",
  "type": "magento2-module",
  "version": "2.1.2",
  "license": "proprietary",
  "authors": [
    {
      "name": "PayFURL",
      "email": "support@payfurl.com"
    }
  ],
  "require": {
    "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
    "magento/framework": "~103.0.7",
    "magento/module-checkout": "~100.4.7",
    "magento/module-config": "~101.2.7",
    "magento/module-customer": "~103.0.7",
    "magento/module-directory": "~100.4.7",
    "magento/module-payment": "~100.4.7",
    "magento/module-quote": "~101.2.7",
    "magento/module-sales": "~103.0.7",
    "magento/module-store": "~101.1.7",
    "payfurl/phpsdk": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "magento/magento-coding-standard": "^41",
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/phpstan": "^2"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://mirror.mage-os.org/",
      "only": ["magento/*"]
    }
  ],
  "config": {
    "allow-plugins": {
      "magento/composer-dependency-version-audit-plugin": false,
      "magento/magento-composer-installer": false,
      "laminas/laminas-dependency-plugin": false,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    },
    "audit": {
      "block-insecure": false
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Payfurl\\Payment\\": ""
    }
  }
}
